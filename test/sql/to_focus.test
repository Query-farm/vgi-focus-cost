# name: test/sql/to_focus.test
# description: to_focus() maps rows DuckDB has already read, identically to focus()
# group: [focus]

require vgi

require-env FOCUS_WORKER

require-env FOCUS_FIXTURES

statement ok
ATTACH 'focus' (TYPE vgi, LOCATION '{FOCUS_WORKER}');

# The standalone runner links no extensions: icu for TIMESTAMPTZ casts in UTC,
# parquet for DuckDB's own reader in to_focus().
statement ok
INSTALL icu;

statement ok
LOAD icu;

statement ok
INSTALL parquet;

statement ok
LOAD parquet;

statement ok
SET TimeZone = 'UTC';


query III
SELECT count(*), sum(BilledCost), sum(EffectiveCost)
FROM focus.main.to_focus((SELECT * FROM read_parquet('{FOCUS_FIXTURES}/aws_cur2/acme-cur2/data/*/*.parquet')));
----
576	1843.212986	1123.512986

# Same rows either way.
query I
SELECT count(*) FROM (
  SELECT ChargePeriodStart, BilledCost, EffectiveCost, ResourceId, x_ChargeType
  FROM focus.main.to_focus((SELECT * FROM read_parquet('{FOCUS_FIXTURES}/aws_cur2/acme-cur2/data/*/*.parquet')))
  EXCEPT ALL
  SELECT ChargePeriodStart, BilledCost, EffectiveCost, ResourceId, x_ChargeType FROM focus.main.focus('{FOCUS_FIXTURES}/aws_cur2'));
----
0

# DuckDB's CSV reader (all text) into the Azure mapping.
query II
SELECT count(*), sum(EffectiveCost)
FROM focus.main.to_focus((SELECT * FROM read_csv('{FOCUS_FIXTURES}/azure/contoso-actual-cost-202607.csv', all_varchar = true)));
----
160	288.197446

query TI
SELECT ServiceCategory, sum(EffectiveCost) FROM focus.main.to_focus(
  (SELECT * FROM read_parquet('{FOCUS_FIXTURES}/azure/contoso-amortized-cost-202607.parquet')), source := 'azure_amortized')
GROUP BY ALL ORDER BY ALL;
----
Compute	233.223000
Management and Governance	99.000000
Networking	8.676249
Other	-0.010000
Storage	37.683197
Web	156.240000

# Nested GCP structs and credit arrays survive DuckDB's Parquet reader.
query II
SELECT count(*), sum(BilledCost) FROM focus.main.to_focus((SELECT * FROM read_parquet('{FOCUS_FIXTURES}/gcp/*.parquet')));
----
127	673.770000

# Native FOCUS through DuckDB's CSV reader, as FOCUS 1.3.
query TI
SELECT ServiceProviderName, count(*) FROM focus.main.to_focus(
  (SELECT * FROM read_csv('{FOCUS_FIXTURES}/focus_sample/focus_sample_1_0.csv')), spec_version := '1.3')
GROUP BY ALL ORDER BY ALL;
----
Amazon Web Services Canada, Inc.	6
Amazon Web Services, Inc.	114
Microsoft	119
Oracle	60
NULL	1

# Empty input gives no rows.
query I
SELECT count(*) FROM focus.main.to_focus((SELECT * FROM read_parquet('{FOCUS_FIXTURES}/gcp/*.parquet') WHERE false));
----
0

statement error
SELECT * FROM focus.main.to_focus((SELECT 1 AS a, 2 AS b));
----
<REGEX>:.*could not recognise the export format.*
